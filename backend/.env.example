# ============================================
#  AURORA INTIMATES — BACKEND (Render)
# ============================================
# Copia este archivo como `.env` y rellena los valores.
# En Render NO se sube el .env: se agregan en Environment Variables del servicio.

# Puerto que usa Render (lo define el propio Render; 4000 en local)
PORT=4000
NODE_ENV=development

# ---------------------------------------------------------
# SUPABASE
# Dashboard -> Project Settings -> API
# ---------------------------------------------------------
SUPABASE_URL=https://TU_PROYECTO.supabase.co

# Usa la "service_role" key (privada, NUNCA la pongas en el frontend).
SUPABASE_SERVICE_ROLE_KEY=TU_SUPABASE_SERVICE_ROLE_KEY

# ---------------------------------------------------------
# CORS — dominios del frontend separados por coma.
# Usa * en desarrollo; en producción pon tus dominios:
#   https://tu-frontend.vercel.app,https://aurora-intimates.com
# ---------------------------------------------------------
CORS_ORIGINS=*

# ---------------------------------------------------------
# REGLOS DE TIENDA
# ---------------------------------------------------------
FREE_SHIPPING_THRESHOLD=50
SHIPPING_COST=0