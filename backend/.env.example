# ============================================
#  LANË — BACKEND (Render)
# ============================================
# Copia este archivo como `.env` y rellena los valores.
# En Render NO se sube el .env: se agregan en Environment Variables del servicio.

# Puerto que usa Render (lo define el propio Render; 4000 en local)
PORT=4000
NODE_ENV=development

# ---------------------------------------------------------
# SUPABASE
# Dashboard -> Project Settings -> API
# ---------------------------------------------------------
SUPABASE_URL=https://TU_PROYECTO.supabase.co

# Usa la "service_role" key (privada, NUNCA la pongas en el frontend).
SUPABASE_SERVICE_ROLE_KEY=TU_SUPABASE_SERVICE_ROLE_KEY

# ---------------------------------------------------------
# CORS — dominios del frontend separados por coma.
# Usa * en desarrollo; en producción pon tus dominios:
#   https://tu-frontend.vercel.app,https://lane.com
# ---------------------------------------------------------
CORS_ORIGINS=*

# ---------------------------------------------------------
# REGLOS DE TIENDA
# ---------------------------------------------------------
FREE_SHIPPING_THRESHOLD=50
SHIPPING_COST=0

# ---------------------------------------------------------
# PAYPAL — https://developer.paypal.com/dashboard/applications
# ---------------------------------------------------------
# Sandbox: usa las credenciales de "Sandbox" de tu app.
# Live: cambia a las credenciales "Live" y PAYPAL_MODE=live.
PAYPAL_CLIENT_ID=TU_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=TU_PAYPAL_CLIENT_SECRET
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=USD

# Opcional pero recomendado: ID del webhook creado en el dashboard de PayPal.
# URL del webhook: https://TU-BACKEND.onrender.com/api/payments/paypal/webhook
PAYPAL_WEBHOOK_ID=